<!DOCTYPE html>
<html lang="da">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>BYENS FRISØR</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: linear-gradient(145deg, #050505, #151515);
      color: #d4af37;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 30px 20px;
    }

    .container {
      width: 100%;
      max-width: 430px;
      text-align: center;
    }

    h1 {
      font-size: 34px;
      margin: 0;
      letter-spacing: 3px;
      color: #d4af37;
    }

    .barber {
      margin-top: 8px;
      color: #b7b7b7;
      letter-spacing: 5px;
      font-size: 14px;
    }

    .line {
      width: 90px;
      height: 2px;
      margin: 22px auto 30px;
      background: linear-gradient(
        90deg,
        transparent,
        #d4af37,
        #c0c0c0,
        #d4af37,
        transparent
      );
    }

    .welcome {
      color: #d4af37;
      margin-bottom: 25px;
      font-size: 16px;
    }

    .link {
      display: block;
      width: 100%;
      padding: 17px;
      margin: 14px 0;
      border: 1px solid #d4af37;
      border-radius: 14px;
      color: #d4af37;
      text-decoration: none;
      font-size: 18px;
      font-weight: bold;
      background: linear-gradient(135deg, #111, #1d1d1d);
      box-shadow: 0 5px 18px rgba(0,0,0,.45);
    }

    .link:active {
      transform: scale(.98);
    }

    .info {
      margin-top: 35px;
      padding-top: 22px;
      border-top: 1px solid #555;
      line-height: 1.8;
      font-size: 14px;
    }

    .info a {
      color: #d4af37;
      text-decoration: none;
    }

    .titanium {
      color: #b7b7b7;
    }

    footer {
      margin-top: 25px;
      color: #777;
      font-size: 12px;
    }
  </style>
</head>

<body>

<div class="container">

  <h1>BYENS FRISØR</h1>
  <div class="barber">BARBER SHOP</div>

  <div class="line"></div>

  <div class="welcome">
    Følg os på sociale medier
  </div>

  <a class="link"
     href="https://www.instagram.com/byensfrisor1?igsi=MTdrYnR1bTRjeXFmZQ%3D%3D&utm_source=qr">
     INSTAGRAM
  </a>

  <a class="link"
     href="https://www.facebook.com/share/1DPv59djf7/?mibextid=wwXIfr">
     FACEBOOK
  </a>

  <a class="link"
     href="https://www.tiktok.com/@byensfrisr2?_r=1&_t=ZN-99NbrMxhvFu">
     TIKTOK
  </a>

  <a class="link"
     href="https://snapchat.com/t/La5srYSM">
     SNAPCHAT
  </a>

  <div class="info">

    📍 <span class="titanium">Centervejen 3B, 3230 Græsted</span><br>

    ☎️
    <a href="tel:+4525631818">
      +45 25 63 18 18
    </a><br>

    ✉️
    <a href="mailto:byensfrisor1@gmail.com">
      byensfrisor1@gmail.com
    </a>

  </div>

  <footer>
    © BYENS FRISØR
  </footer>

</div>

</body>
</html>